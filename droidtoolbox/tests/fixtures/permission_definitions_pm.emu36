+ group:android.permission-group.UNDEFINED
  package:android
  label:null
  description:null
  + permission:android.permission.READ_SMS
    package:android
    label:读取短信
    description:此应用可读取您手机上存储的所有短信。
    protectionLevel:dangerous
  + permission:android.permission.READ_CALENDAR
    package:android
    label:读取日历活动和详情
    description:此应用可读取您手机上存储的所有日历活动，并分享或保存您的日历数据。
    protectionLevel:dangerous
  + permission:android.permission.POST_NOTIFICATIONS
    package:android
    label:显示通知
    description:允许该应用显示通知
    protectionLevel:dangerous|instant
  + permission:android.permission.READ_CALL_LOG
    package:android
    label:读取通话记录
    description:此应用可读取您的通话记录。
    protectionLevel:dangerous
  + permission:android.permission.ACCESS_FINE_LOCATION
    package:android
    label:只能在前台获取精确的位置信息
    description:当您使用此应用时，此应用可以通过位置信息服务获取您的确切位置信息。您必须开启设备的位置信息服务，此应用才能获取位置信息。这可能会增加耗电量。
    protectionLevel:dangerous|instant
  + permission:android.permission.MANAGE_EXTERNAL_STORAGE
    package:android
    label:null
    description:null
    protectionLevel:signature|appop|preinstalled
  + permission:android.permission.ANSWER_PHONE_CALLS
    package:android
    label:接听来电
    description:允许该应用接听来电。
    protectionLevel:dangerous|runtime
  + permission:android.permission.ACCESS_LOCAL_NETWORK
    package:android
    label:访问本地网络设备
    description:允许此应用访问本地网络设备
    protectionLevel:dangerous
  + permission:android.permission.RECEIVE_WAP_PUSH
    package:android
    label:接收讯息 (WAP)
    description:允许该应用接收和处理 WAP 消息。此权限包括监视发送给您的消息或删除发送给您的消息而不向您显示的功能。
    protectionLevel:dangerous
  + permission:android.permission.BODY_SENSORS
    package:android
    label:在使用期间可访问身体传感器数据，如心率
    description:允许应用在使用期间访问身体传感器数据，如心率、体温和血氧浓度。
    protectionLevel:dangerous
  + permission:android.permission.READ_PHONE_NUMBERS
    package:android
    label:读取电话号码
    description:允许该应用访问设备上的电话号码。
    protectionLevel:dangerous|instant
  + permission:android.permission.READ_MEDIA_VISUAL_USER_SELECTED
    package:android
    label:从共享存储空间读取用户选择的图片和视频文件
    description:使应用能够从共享存储空间读取您所选的图片和视频文件。
    protectionLevel:dangerous
  + permission:android.permission.NEARBY_WIFI_DEVICES
    package:android
    label:与附近的 WLAN 设备互动
    description:允许该应用向附近的 WLAN 设备进行广播、连接到这些设备以及确定这些设备的相对位置
    protectionLevel:dangerous
  + permission:android.permission.RECEIVE_MMS
    package:android
    label:接收讯息（彩信）
    description:允许该应用接收和处理彩信。这就意味着，该应用可能会监视发送到您设备的彩信，或删除发送到您设备的彩信而不向您显示。
    protectionLevel:dangerous
  + permission:android.permission.RECEIVE_SMS
    package:android
    label:接收讯息（短信）
    description:允许该应用接收和处理短信。这就意味着，该应用可能会监视发送到您设备的短信，或删除发送到您设备的短信而不向您显示。
    protectionLevel:dangerous
